generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  passwordHash  String
  profileData   String?      // Stored as JSON string (gender, ageGroup, category, fitnessLevel, etc.)
  microcycle    Microcycle?
  dailyLogs     DailyLog[]
  stationPRs    StationPR[]
  trainingPlans TrainingPlan[]
  workoutTemplates WorkoutTemplate[]
  racePlans     RacePlan[]
  readinessSnapshots ReadinessSnapshot[]
  coachGenerations CoachGeneration[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model StationPR {
  id          String   @id @default(cuid())
  userId      String
  station     String   // e.g., "SkiErg", "SledPush", "Run1km"
  timeMs      Int      // Personal record time in milliseconds
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, station])
}

model Microcycle {
  id        String   @id @default(cuid())
  userId    String   @unique
  data      String   // Stored as JSON string (the whole weekly plan)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyLog {
  id          String   @id @default(cuid())
  userId      String
  date        String   // YYYY-MM-DD
  totalTimeMs Int      // total time
  blockLogs   String   // JSON string of block specific logs
  rpe         Int?     // Rating of Perceived Exertion (1-10)
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model TrainingPlan {
  id               String   @id @default(cuid())
  userId           String
  title            String
  startDate        String
  endDate          String
  raceDate         String
  goal             String
  status           String   @default("active")
  planLevel        String
  currentWeekIndex Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeks            TrainingWeek[]
  racePlans        RacePlan[]
  generations      CoachGeneration[]

  @@index([userId, status])
}

model TrainingWeek {
  id                String   @id @default(cuid())
  planId            String
  weekIndex         Int
  phase             String
  focus             String
  volumeTarget      Int
  readinessSnapshot Json?
  planAdjustments   Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  plan              TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  workouts          ScheduledWorkout[]

  @@unique([planId, weekIndex])
}

model ScheduledWorkout {
  id              String   @id @default(cuid())
  userId          String
  weekId          String?
  date            String
  source          String
  isCompleted     Boolean  @default(false)
  isSubstituted    Boolean  @default(false)
  workout          Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  week            TrainingWeek? @relation(fields: [weekId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}

model WorkoutTemplate {
  id                String   @id @default(cuid())
  userId            String?
  title             String
  focus             String
  duration          Int
  equipmentRequired Json
  difficulty        String
  blocks            Json
  isFavorite        Boolean  @default(false)
  isBuiltIn         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, focus])
}

model RacePlan {
  id              String   @id @default(cuid())
  userId          String
  trainingPlanId  String?
  title           String
  targetTimeMs    Int
  division        String
  gender          String
  eventType       String   @default("Individual")
  stationSplits   Json
  runSplits       Json
  roxzoneMs       Int
  projectedTimeMs Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingPlan    TrainingPlan? @relation(fields: [trainingPlanId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model ReadinessSnapshot {
  id               String   @id @default(cuid())
  userId           String
  date             String
  level            String
  avgRpe           Float?
  maxRpe           Float?
  completedSessions Int
  painSignals      Json
  redFlagSignals   Json
  volumeMultiplier Float
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model CoachGeneration {
  id             String   @id @default(cuid())
  userId         String
  trainingPlanId String?
  generationType String
  status         String
  fallbackUsed   Boolean  @default(false)
  failureReason  String?
  metadata       Json?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingPlan   TrainingPlan? @relation(fields: [trainingPlanId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}
